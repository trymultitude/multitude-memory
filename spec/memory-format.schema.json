{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trymultitude/multitude-memory/spec/memory-format.schema.json",
  "title": "Multitude Memory Format 1.x",
  "type": "object",
  "required": ["format", "version", "exported_at", "memories"],
  "properties": {
    "format": { "const": "multitude-memory" },
    "version": { "type": "string", "pattern": "^1\\.\\d+$" },
    "exported_at": { "type": "string", "format": "date-time" },
    "workspace": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" }, "about": { "type": "string" } }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\w{1,64}$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "instructions": { "type": "string" }
        }
      }
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "key", "text", "scope", "status", "source", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^\\w{1,64}$" },
          "key": { "type": "string", "minLength": 1, "maxLength": 120 },
          "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "scope": { "enum": ["team", "private"] },
          "status": { "enum": ["current", "superseded"] },
          "superseded_by": { "type": ["string", "null"] },
          "source": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["person", "agent", "import"] },
              "agent": { "type": "string", "pattern": "^[a-z0-9_-]{1,40}$" },
              "author": { "type": "string" },
              "origin": { "type": "string" }
            }
          },
          "project": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
